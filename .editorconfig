# Encodings per area (see tests/README.md). Editors and Visual Studio thus do not accidentally save in another encoding.
root = true

[*]
charset = latin1
insert_final_newline = false
trim_trailing_whitespace = false

# DLL source code, wrappers and example projects: Windows-1252 (VB6 and older Delphi versions expect ANSI);
# the generated HTML documentation is ISO-8859-1. Line endings: CRLF.
[*.{cpp,h,c,def,idl,rc,rgs,bas,cls,frm,vbp,vb,cs,pas,html,htm}]
charset = latin1
end_of_line = crlf

[*.{vcxproj,filters,vspscc,slnx,sln}]
charset = utf-8-bom
end_of_line = crlf

# Tests, scripts and documentation: UTF-8 without BOM (tests/run.bat compiles with /utf-8)
[tests/**]
charset = utf-8
end_of_line = crlf

[*.{py,md,json,yml}]
charset = utf-8
end_of_line = lf

[tests/**.{py,md}]
charset = utf-8
end_of_line = lf

[*.bat]
charset = utf-8
end_of_line = crlf

# doku/ is generated by Doxygen (UTF-8, LF), do not edit by hand: "doxygen Doxyfile"
[doku/**]
charset = utf-8
end_of_line = lf
