# Zeilenenden: Text wird im Repository mit LF gespeichert und unter Windows als CRLF ausgecheckt.
* text=auto

# Windows-Quellen und Batch-Dateien immer mit CRLF auschecken (VB6-Dateien, Batch und Visual Studio verlangen das)
*.cpp  text eol=crlf
*.h    text eol=crlf
*.c    text eol=crlf
*.def  text eol=crlf
*.idl  text eol=crlf
*.rc   text eol=crlf
*.bas  text eol=crlf
*.cls  text eol=crlf
*.frm  text eol=crlf
*.vbp  text eol=crlf
*.vb   text eol=crlf
*.cs   text eol=crlf
*.pas  text eol=crlf
*.bat  text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.slnx text eol=crlf

# Skripte und Doku: LF
*.py   text eol=lf
*.md   text eol=lf

# Binaerdateien nie umwandeln (Audio-Fixtures, Bibliotheken, Bilder, Archive)
*.dll binary
*.lib binary
*.exe binary
*.obj binary
*.zip binary
*.bmp binary
*.gif binary
*.jpg binary
*.png binary
*.ico binary
*.mp3 binary
*.wav binary
*.flac binary
*.ogg binary
*.m4a binary
*.wma binary
*.wv binary
*.tta binary
*.ape binary
*.mpc binary
*.aac binary
*.bin binary

# Generierte Doxygen-Doku: unveraendert speichern, in Diffs als generiert markieren
doku/** -text linguist-generated
